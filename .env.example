# Servidor
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_chatbot_hub_2026
ADMIN_EMAIL=admin@chatbot.local
ADMIN_PASSWORD=admin123456

# WhatsApp Cloud API (Oficial de Meta)
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_VERIFY_TOKEN=chatbot_meta_verify_token_2026
WA_CLOUD_APP_SECRET=

# Evolution API (Alternativa No Oficial)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=chatbot_instance

# Configuración IA (OpenAI / Gemini / OpenCode Zen / Custom)
AI_PROVIDER=none # options: 'none', 'openai', 'gemini', 'opencode', 'custom'
AI_MAX_TOKENS=350 # límite de tokens por respuesta (más alto = respuestas más largas; ej: 800, 1200)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=
# OpenCode Zen / Go — usa tu API key de https://opencode.ai/zen
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free # modelos gratis: deepseek-v4-flash-free, nemotron-3-ultra-free, big-pickle
# Custom — cualquier API compatible con OpenAI (OpenRouter, Groq, DeepSeek, Ollama, etc.)
CUSTOM_API_URL=https://openrouter.ai/api/v1/chat/completions
CUSTOM_API_KEY=
CUSTOM_MODEL=
AI_SYSTEM_PROMPT=Eres un asistente virtual amable y profesional. Respondes preguntas sobre nuestros servicios, horarios, ubicación y precios. Si no sabes la respuesta o el cliente solicita hablar con un humano, indícale amablemente que un agente lo atenderá en breve.

# Configuración General Chatbot
BOT_ENABLED=true
AUTO_ASSIGN_HUMAN=false
# Número de WhatsApp (con código de país, sin + ni espacios) para recibir
# avisos cuando un cliente pide atención humana en el chat web.
# Ej: 5215512345678
ALERT_PHONE=
WELCOME_MESSAGE=¡Hola! 👋 Bienvenido. ¿En qué podemos ayudarte hoy?
OUT_OF_HOURS_MESSAGE=Gracias por escribirnos. Nuestro horario de atención es de Lunes a Viernes de 8:00 AM a 5:00 PM. Te responderemos tan pronto estemos de regreso.
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=17:00
BUSINESS_HOURS_DAYS=1,2,3,4,5 # 1=Lunes, 7=Domingo
TIMEZONE=UTC # Zona horaria para calcular horario de atención. Ej: America/Mexico_City, America/Bogota, America/Argentina/Buenos_Aires, Europe/Madrid
